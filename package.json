{
  "name": "site-gaucho-figueiras",
  "private": true,
  "version": "2.0.0",
  "description": "Site do Gaúcho Figueiras Grill com intro 3D",
  "scripts": {
    "build": "esbuild src/intro3d/main.js --bundle --format=esm --minify --target=es2019 --legal-comments=none --outfile=assets/js/intro3d.js",
